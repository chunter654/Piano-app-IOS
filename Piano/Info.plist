<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app uses no encryption of any kind. Declaring it here means App
	     Store Connect stops asking the export compliance question on every
	     upload. Everything else in the bundle is generated from build
	     settings and merged on top of this file. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
